# Include inside the coachlink.fit HTTPS server block.
# For dev.coachlink.fit use the dev NodePort 30011 instead of 30010.
location = /api/plan-lib/batch-operation {
    proxy_pass http://127.0.0.1:30010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    # The application sends a heartbeat every 15 seconds during model requests.
    proxy_read_timeout 180s;
}
