page { background: #F5F1EB; color: #302A25; }
.container { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.note { font-size: 26rpx; line-height: 1.6; margin-top: 16rpx; word-break: break-all; }
.card { background: #FFFFFF; padding: 32rpx; border-radius: 24rpx; margin-top: 24rpx; }
.label { font-size: 28rpx; margin-bottom: 16rpx; }
.selection { padding: 24rpx; border: 1rpx solid #CF6D4E; border-radius: 16rpx; font-size: 28rpx; }
button { background: #CF6D4E; color: #FFFFFF; margin-top: 24rpx; border-radius: 16rpx; font-size: 28rpx; }
button.secondary { background: #FFFFFF; color: #CF6D4E; border: 1rpx solid #CF6D4E; }
button[disabled] { opacity: 0.5; }
.status { font-size: 30rpx; font-weight: 600; }
