# Required. This file only selects the config source and, for Apollo, provides
# bootstrap connection settings. Business config must live in exactly one source.
#
# local: load business config from LOCAL_ENV_FILE.
# apollo: fetch all business config from Apollo and do not load local env files.
CONFIG_SOURCE=local

# Used only when CONFIG_SOURCE=local.
# Default is .env.development for dev and .env.production for build/start.
LOCAL_ENV_FILE=.env.development

# Used only when CONFIG_SOURCE=apollo.
APOLLO_CONFIG_SERVER_URL=https://apollo-configservice.example.com
APOLLO_APP_ID=coachlink
APOLLO_CLUSTER=local
APOLLO_NAMESPACES=application.env
# APOLLO_ACCESS_KEY_SECRET=
# APOLLO_LABEL=

# LLM business config belongs in the selected LOCAL_ENV_FILE or Apollo, not here.
# WANJIE_ARK_API_KEY=<万界方舟API Key>
# WANJIE_ARK_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1
# WANJIE_ARK_MODEL=deepseek-v4-pro
# WANJIE_ARK_FAST_MODEL=deepseek-v4-flash      # short classification/check tasks; defaults to this
# WANJIE_ARK_PLAN_MODEL=deepseek-v4-pro       # optional; omit to inherit WANJIE_ARK_MODEL
# WANJIE_ARK_PLAN_SCRIPT_MODEL=deepseek-v4-flash # ordinary PlanScript edits; defaults to this
# WANJIE_ARK_PLAN_SCRIPT_FALLBACK_MODEL=claude-sonnet-4-6 # only for detailed long-plan layouts the local parser cannot determine
# WANJIE_ARK_ANTHROPIC_MESSAGES_URL=https://maas-openapi.wanjiedata.com/api/anthropic/v1/messages
# WANJIE_ARK_COACH_REPLY_MODEL=deepseek-v4-pro # optional; omit to inherit WANJIE_ARK_MODEL
# WANJIE_ARK_VISION_MODEL=qwen3-vl-flash       # plan image import / vision input

# Native mobile push server config also belongs in the selected LOCAL_ENV_FILE
# or Apollo. Keep these values server-only; never prefix the secrets with
# NEXT_PUBLIC_ / EXPO_PUBLIC_.
# MOBILE_PUSH_CRON_SECRET=<at-least-32-random-bytes>
# MOBILE_PUSH_DRAIN_INTERVAL_MS=15000
# EXPO_ACCESS_TOKEN=<optional-Expo-push-access-token>
# The public EAS project id is injected only into the mobile build:
# EXPO_PUBLIC_EAS_PROJECT_ID=<eas-project-uuid>

# Supabase → 自建 PostgreSQL 迁移（scripts/migrate-supabase-to-postgres.ts）
# SOURCE 用 Supabase Dashboard → Database → Connection string（URI，非 REST URL）
# SOURCE_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
# TARGET_DATABASE_URL=postgresql://app_user:[password]@154.8.205.78:5432/coachlink?sslmode=disable
# 或离散字段：SOURCE_DB_HOST / SOURCE_DB_USER / ... 与 TARGET_DB_* 同理

# Power Analysis worker queue business config belongs in the selected LOCAL_ENV_FILE
# or Apollo, not in root .env. Example local values:
# TASK_QUEUE_DRIVER=memory
# TASK_QUEUE_BUFFER_SIZE=1024
# TASK_QUEUE_TOPIC=coachlink-power-analysis-tasks
# TASK_QUEUE_CONSUMER_GROUP=coachlink-power-workers-local
# TASK_QUEUE_CLIENT_ID=coachlink-power-worker-local
# POWER_ANALYSIS_RECOVER_INTERVAL_MS=5000
# POWER_ANALYSIS_RECOVER_BATCH_SIZE=50

# Kafka mode, normally configured in Apollo for dev/main.
# TASK_QUEUE_DRIVER=kafka
# TASK_QUEUE_BROKERS=kafka-0.kafka:9092,kafka-1.kafka:9092,kafka-2.kafka:9092
# TASK_QUEUE_TOPIC=coachlink-power-analysis-tasks
# TASK_QUEUE_CONSUMER_GROUP=coachlink-power-workers
# TASK_QUEUE_CLIENT_ID=coachlink-power-worker
