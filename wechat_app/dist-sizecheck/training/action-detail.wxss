.action-detail-page{min-height:100vh;padding:24rpx 24rpx 48rpx;background:-webkit-gradient(linear,left top,left bottom,from(#e8e8e8),to(#f8f8f8));background:-webkit-linear-gradient(top,#e8e8e8 0%,#f8f8f8 100%);background:linear-gradient(180deg,#e8e8e8 0%,#f8f8f8 100%);-webkit-box-sizing:border-box;box-sizing:border-box}.action-detail-page .action-card{background:#fff;border-radius:32rpx;padding:32rpx;-webkit-box-shadow:0 8rpx 32rpx rgba(0,0,0,.04);box-shadow:0 8rpx 32rpx rgba(0,0,0,0.03922);border:2rpx solid #f0f0f0}.action-detail-page .title{display:block;font-size:36rpx;font-weight:700;color:#010101;margin-bottom:8rpx}.action-detail-page .type-tag{display:inline-block;background:#eff6ff;color:#2563eb;font-size:22rpx;border-radius:1000rpx;padding:8rpx 16rpx;margin-bottom:16rpx}.action-detail-page .section{margin-top:16rpx}.action-detail-page .section-title{display:block;font-size:26rpx;font-weight:600;color:#374151;margin-bottom:8rpx}.action-detail-page .section-content{display:block;font-size:26rpx;color:#4b5563;line-height:1.7}.action-detail-page .tag-list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:8rpx}.action-detail-page .tag{font-size:22rpx;color:#4b5563;background:#f3f4f6;border-radius:1000rpx;padding:8rpx 16rpx}.action-detail-page .video-url{display:block;font-size:24rpx;color:#2563eb;word-break:break-all;line-height:1.5}.action-detail-page .copy-btn{margin-top:16rpx;background:#2563eb;border-radius:8rpx;padding:16rpx;width:-webkit-fit-content;width:-moz-fit-content;width:fit-content}.action-detail-page .copy-btn Text{color:#fff;font-size:24rpx}.action-detail-page .empty-state{margin-top:24rpx;padding-top:16rpx;border-top:1rpx solid #e5e7eb}.action-detail-page .empty-text{display:block;font-size:24rpx;color:#6b7280;line-height:1.6}.action-detail-page .id-hint{display:block;margin-top:8rpx;font-size:22rpx;color:#9ca3af}
