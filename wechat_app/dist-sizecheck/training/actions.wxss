.student-action-lib-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#e8e8e8),to(#f8f8f8));background:-webkit-linear-gradient(top,#e8e8e8 0%,#f8f8f8 100%);background:linear-gradient(180deg,#e8e8e8 0%,#f8f8f8 100%);padding-bottom:200rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.student-action-lib-page .hint-card{background:#fff;border:2rpx solid #e5e7eb;border-radius:24rpx;padding:24rpx;margin:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box;-webkit-box-shadow:0 4rpx 24rpx rgba(0,0,0,.04);box-shadow:0 4rpx 24rpx rgba(0,0,0,0.03922)}.student-action-lib-page .hint-card .hint-text{font-size:28rpx;color:#6b7280;text-align:center;line-height:1.6}.student-action-lib-page .search-bar{background:#fff;padding:24rpx 32rpx;border-bottom:2rpx solid #e5e7eb}.student-action-lib-page .search-bar .search-input{background:#f3f4f6;border-radius:16rpx;padding:16rpx 24rpx;font-size:28rpx;color:#111827}.student-action-lib-page .loading-wrap,.student-action-lib-page .empty-wrap{padding:80rpx 40rpx;text-align:center;color:#9ca3af;font-size:28rpx}.student-action-lib-page .action-list{padding:24rpx;height:calc(100vh - 240rpx)}.student-action-lib-page .action-card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;border:2rpx solid #e5e7eb;-webkit-box-sizing:border-box;box-sizing:border-box}.student-action-lib-page .action-card .action-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:16rpx}.student-action-lib-page .action-card .action-header .action-name{font-size:32rpx;font-weight:700;color:#111827;-webkit-flex:1;-ms-flex:1;flex:1}.student-action-lib-page .action-card .action-header .action-type{font-size:24rpx;color:#6b7280;background:#f3f4f6;padding:4rpx 16rpx;border-radius:8rpx}.student-action-lib-page .action-card .action-detail{font-size:28rpx;color:#6b7280;line-height:1.5;margin-bottom:16rpx;display:block}.student-action-lib-page .action-card .action-tags{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:12rpx;margin-bottom:16rpx}.student-action-lib-page .action-card .action-tags .tag{font-size:24rpx;color:#059669;background:#ecfdf5;padding:4rpx 16rpx;border-radius:8rpx}.student-action-lib-page .action-card .action-time{font-size:24rpx;color:#9ca3af;display:block}.student-action-lib-page .load-more,.student-action-lib-page .no-more{text-align:center;padding:32rpx;color:#9ca3af;font-size:28rpx}
