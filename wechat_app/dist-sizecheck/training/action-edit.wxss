.action-edit-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#e8e8e8),to(#f8f8f8));background:-webkit-linear-gradient(top,#e8e8e8 0%,#f8f8f8 100%);background:linear-gradient(180deg,#e8e8e8 0%,#f8f8f8 100%);padding:24rpx 24rpx 120rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.form-group{margin-bottom:32rpx;background:#fff;border-radius:24rpx;padding:32rpx;border:2rpx solid #f0f0f0;-webkit-box-shadow:0 4rpx 24rpx rgba(0,0,0,.04);box-shadow:0 4rpx 24rpx rgba(0,0,0,0.03922)}.form-label{display:block;font-size:28rpx;font-weight:600;color:#374151;margin-bottom:16rpx}.form-label .required{color:#dc2626;margin-left:0rpx}.form-input{width:100%;min-height:72rpx;padding:16rpx 24rpx;font-size:28rpx;color:#1f2937;background:#f9fafb;border:2rpx solid #e5e7eb;border-radius:8rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.form-textarea{min-height:160rpx;resize:none}.type-options{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.type-option{padding:16rpx 24rpx;font-size:26rpx;border-radius:8rpx;border:2rpx solid #e5e7eb;background:#fff;color:#6b7280}.type-option.active{border-color:#cf6d4e;background:#fff7ed;color:#ea580c;font-weight:600}.submit-wrap{position:fixed;left:0;right:0;bottom:0;padding:24rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-top:2rpx solid #f0f0f0}.btn-submit{width:100%;padding:24rpx;font-size:32rpx;font-weight:600;color:#fff;text-align:center;background:#cf6d4e;border-radius:16rpx}.btn-submit.disabled{background:#e5e7eb;color:#9ca3af;pointer-events:none}
