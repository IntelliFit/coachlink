.action-edit-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%)}.action-edit-page .page-scroll{height:100vh;padding-bottom:144rpx}.action-edit-page .page-content{padding:24rpx}.action-edit-page .loading{text-align:center;padding:48rpx;font-size:28rpx;color:#999}.action-edit-page .page-header{margin-bottom:32rpx}.action-edit-page .page-header .page-title{font-size:40rpx;font-weight:700;color:#333;display:block}.action-edit-page .page-header .page-subtitle{font-size:26rpx;color:#999;margin-top:8rpx;display:block}.action-edit-page .form-section{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03922)}.action-edit-page .form-section .section-title{font-size:32rpx;font-weight:600;color:#333;margin-bottom:16rpx;display:block}.action-edit-page .form-section .section-hint{font-size:24rpx;color:#999;margin-top:16rpx;display:block}.action-edit-page .form-field{margin-bottom:16rpx}.action-edit-page .form-field:last-child{margin-bottom:0}.action-edit-page .form-field .field-label{font-size:28rpx;color:#666;margin-bottom:8rpx;display:block}.action-edit-page .form-field .field-label .required{color:#ff4d4f}.action-edit-page .form-field .field-input{width:100%;height:80rpx;padding:0 16rpx;border:1rpx solid #e8e8e8;border-radius:8rpx;font-size:28rpx;background:#fafafa}.action-edit-page .form-field .field-textarea{width:100%;height:160rpx;padding:16rpx;border:1rpx solid #e8e8e8;border-radius:8rpx;font-size:28rpx;background:#fafafa}.action-edit-page .form-field .field-hint{font-size:24rpx;color:#999;margin-top:8rpx;display:block}.action-edit-page .option-list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.action-edit-page .option-list .option-item{padding:8rpx 24rpx;background:#f5f5f5;border-radius:8rpx;border:2rpx solid transparent}.action-edit-page .option-list .option-item Text{font-size:26rpx;color:#666}.action-edit-page .option-list .option-item.selected{background:#e6f7ff;border-color:#1890ff}.action-edit-page .option-list .option-item.selected Text{color:#1890ff}.action-edit-page .option-list .option-item:active{opacity:.8}.action-edit-page .bottom-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;padding:24rpx 0 48rpx}.action-edit-page .bottom-actions .primary-btn,.action-edit-page .bottom-actions .secondary-btn{-webkit-flex:1;-ms-flex:1;flex:1;padding:24rpx 0;border-radius:8rpx;text-align:center}.action-edit-page .bottom-actions .primary-btn Text,.action-edit-page .bottom-actions .secondary-btn Text{font-size:30rpx;font-weight:500}.action-edit-page .bottom-actions .primary-btn{background:#1890ff}.action-edit-page .bottom-actions .primary-btn Text{color:#fff}.action-edit-page .bottom-actions .primary-btn.loading{opacity:.7}.action-edit-page .bottom-actions .primary-btn:active{opacity:.9}.action-edit-page .bottom-actions .secondary-btn{background:#f5f5f5;border:1rpx solid #d9d9d9}.action-edit-page .bottom-actions .secondary-btn Text{color:#666}.action-edit-page .bottom-actions .secondary-btn:active{background:#e8e8e8}
