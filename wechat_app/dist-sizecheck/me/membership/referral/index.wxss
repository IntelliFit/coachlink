.referral-page{min-height:100vh;background:#f3f4f6;padding-bottom:140rpx}.referral-page .page-scroll{height:calc(100vh - 140rpx)}.referral-page .page-content{padding:24rpx}.referral-page .page-header{margin-bottom:32rpx;padding:0 8rpx}.referral-page .page-header .page-title{display:block;font-size:48rpx;font-weight:700;color:#1f2937;margin-bottom:8rpx}.referral-page .page-header .page-subtitle{display:block;font-size:26rpx;color:#6b7280}.referral-page .code-card{background:#f97316;border-radius:24rpx;padding:40rpx;margin-bottom:24rpx;-webkit-box-shadow:0 8rpx 24rpx rgba(249,115,22,.3);box-shadow:0 8rpx 24rpx rgba(249,115,22,0.30196)}.referral-page .code-card .code-label{display:block;font-size:26rpx;color:rgba(255,255,255,0.90196);margin-bottom:24rpx}.referral-page .code-card .code-display{background:rgba(255,255,255,.2);border-radius:16rpx;padding:32rpx;margin-bottom:32rpx;text-align:center}.referral-page .code-card .code-display .code-text{font-size:64rpx;font-weight:700;color:#fff;letter-spacing:8rpx}.referral-page .code-card .invite-link-box{background:rgba(255,255,255,.15);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:28rpx}.referral-page .code-card .invite-link-box .invite-link-label{display:block;font-size:24rpx;color:rgba(255,255,255,0.85098);margin-bottom:8rpx}.referral-page .code-card .invite-link-box .invite-link-text{display:block;font-size:22rpx;color:#fff;line-height:1.5;word-break:break-all}.referral-page .code-card .code-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx}.referral-page .code-card .code-actions .action-btn{-webkit-flex:1;-ms-flex:1;flex:1;padding:24rpx 0;background:rgba(255,255,255,.2);color:#fff;border-radius:16rpx;text-align:center;font-size:28rpx;font-weight:600;line-height:1.4}.referral-page .code-card .code-actions .action-btn:after{border:none}.referral-page .code-card .code-actions .action-btn.primary{background:#fff;color:#f97316}.referral-page .code-card .code-actions .action-btn.share-action-btn{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.referral-page .code-card .code-actions .action-btn:active{opacity:.8}.referral-page .reward-card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.referral-page .reward-card .reward-title{display:block;font-size:32rpx;font-weight:600;color:#1f2937;margin-bottom:32rpx}.referral-page .reward-card .reward-list{margin-bottom:24rpx}.referral-page .reward-card .reward-list .reward-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:24rpx;padding:24rpx 0;border-bottom:2rpx solid #f3f4f6}.referral-page .reward-card .reward-list .reward-item:last-child{border-bottom:none}.referral-page .reward-card .reward-list .reward-item .reward-icon{font-size:48rpx}.referral-page .reward-card .reward-list .reward-item .reward-content{-webkit-flex:1;-ms-flex:1;flex:1}.referral-page .reward-card .reward-list .reward-item .reward-content .reward-label{display:block;font-size:28rpx;color:#374151;margin-bottom:8rpx}.referral-page .reward-card .reward-list .reward-item .reward-content .reward-value{display:block;font-size:32rpx;font-weight:700;color:#f97316}.referral-page .reward-card .reward-note{display:block;font-size:22rpx;color:#9ca3af;line-height:1.5}.referral-page .stats-card{background:#fff;border-radius:24rpx;padding:32rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.referral-page .stats-card .stats-title{display:block;font-size:32rpx;font-weight:600;color:#1f2937;margin-bottom:32rpx}.referral-page .stats-card .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-gap:24rpx;gap:24rpx}.referral-page .stats-card .stats-grid .stat-item{text-align:center;padding:24rpx;background:#f9fafb;border-radius:16rpx}.referral-page .stats-card .stats-grid .stat-item .stat-value{display:block;font-size:40rpx;font-weight:700;color:#1f2937;margin-bottom:8rpx}.referral-page .stats-card .stats-grid .stat-item .stat-label{display:block;font-size:22rpx;color:#6b7280}.referral-page .loading-wrap{text-align:center;padding:80rpx 40rpx;color:#6b7280}
