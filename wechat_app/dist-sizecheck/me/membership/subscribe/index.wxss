.membership-subscribe-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#e8e8e8),to(#f8f8f8));background:-webkit-linear-gradient(top,#e8e8e8 0%,#f8f8f8 100%);background:linear-gradient(180deg,#e8e8e8 0%,#f8f8f8 100%);padding-bottom:140rpx}.membership-subscribe-page .page-scroll{height:calc(100vh - 140rpx)}.membership-subscribe-page .page-content{padding:24rpx}.membership-subscribe-page .subscribe-status{margin-bottom:32rpx;padding:0 8rpx}.membership-subscribe-page .subscribe-status-text{font-size:26rpx;color:#6b7280;line-height:1.5}.membership-subscribe-page .tab-switcher{display:-webkit-flex;display:-ms-flexbox;display:flex;background:#fff;border-radius:20rpx;padding:8rpx;margin-bottom:32rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.membership-subscribe-page .tab-switcher .tab-item{-webkit-flex:1;-ms-flex:1;flex:1;padding:20rpx 0;text-align:center;font-size:28rpx;font-weight:500;color:#6b7280;border-radius:16rpx;-webkit-transition:all .2s;transition:all .2s}.membership-subscribe-page .tab-switcher .tab-item.active{background:#f97316;color:#fff;font-weight:600}.membership-subscribe-page .plans-list .plan-card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.membership-subscribe-page .plans-list .plan-card .plan-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:32rpx;padding-bottom:24rpx;border-bottom:2rpx solid #f3f4f6}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-name{font-size:36rpx;font-weight:700;color:#1f2937}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-name-wrap{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:12rpx}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-badge{display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;width:-webkit-fit-content;width:-moz-fit-content;width:fit-content;padding:4rpx 16rpx;border-radius:20rpx;background:#ecfdf5;color:#047857;font-size:22rpx;font-weight:600}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-price{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:baseline;-ms-flex-align:baseline;align-items:baseline}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-price .price-symbol{font-size:28rpx;color:#f97316;font-weight:600}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-price .price-amount{font-size:48rpx;color:#f97316;font-weight:700}.membership-subscribe-page .plans-list .plan-card .plan-header .plan-price .price-unit{font-size:24rpx;color:#6b7280;margin-left:4rpx}.membership-subscribe-page .plans-list .plan-card .plan-features{margin-bottom:32rpx}.membership-subscribe-page .plans-list .plan-card .plan-features .feature-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:16rpx;margin-bottom:16rpx}.membership-subscribe-page .plans-list .plan-card .plan-features .feature-item .feature-icon{color:#10b981;font-weight:700}.membership-subscribe-page .plans-list .plan-card .plan-features .feature-item .feature-text{font-size:26rpx;color:#374151}.membership-subscribe-page .plans-list .plan-card .subscribe-btn{padding:24rpx 0;background:#f97316;color:#fff;border-radius:16rpx;text-align:center;font-size:28rpx;font-weight:600;-webkit-box-shadow:0 8rpx 24rpx rgba(249,115,22,.3);box-shadow:0 8rpx 24rpx rgba(249,115,22,0.30196)}.membership-subscribe-page .plans-list .plan-card .subscribe-btn:active{-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.membership-subscribe-page .coupon-tip{margin-bottom:28rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#eff6ff;border:2rpx solid #dbeafe}.membership-subscribe-page .coupon-tip Text{font-size:24rpx;color:#1d4ed8;line-height:1.5}.membership-subscribe-page .empty-state{text-align:center;padding:80rpx 40rpx}.membership-subscribe-page .empty-state .empty-text{display:block;font-size:32rpx;color:#6b7280;margin-bottom:16rpx}.membership-subscribe-page .empty-state .empty-hint{display:block;font-size:24rpx;color:#9ca3af}.membership-subscribe-page .notice-box{margin-top:32rpx;padding:24rpx;background:#fef3c7;border-radius:16rpx;border:2rpx solid #fde68a}.membership-subscribe-page .notice-box .notice-text{font-size:24rpx;color:#92400e;line-height:1.5}.membership-subscribe-page .loading-wrap{text-align:center;padding:80rpx 40rpx;color:#6b7280}
