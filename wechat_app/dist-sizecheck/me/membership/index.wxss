@charset "UTF-8";.membership-page{min-height:100vh;background-color:#f5f5f5}.membership-page .page-scroll{height:100vh;padding-bottom:144rpx}.membership-page .page-content{padding:24rpx}.membership-page .loading{text-align:center;padding:48rpx;font-size:28rpx;color:#999}.membership-page .membership-card{background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);border-radius:24rpx;padding:48rpx;margin-bottom:24rpx;text-align:center}.membership-page .membership-card .tier-badge{background:rgba(255,255,255,.2);display:inline-block;padding:8rpx 32rpx;border-radius:32rpx;margin-bottom:16rpx}.membership-page .membership-card .tier-badge Text{font-size:32rpx;color:#fff;font-weight:600}.membership-page .membership-card .expiry-text{font-size:26rpx;color:rgba(255,255,255,0.8)}.membership-page .quota-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03922)}.membership-page .quota-card .quota-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:16rpx}.membership-page .quota-card .quota-header .quota-title{font-size:30rpx;font-weight:600;color:#333}.membership-page .quota-card .quota-header .quota-status{font-size:26rpx;color:#52c41a;font-weight:500}.membership-page .quota-card .quota-header .quota-status.warning{color:#fa8c16}.membership-page .quota-card .progress-bar{height:16rpx;background:#f0f0f0;border-radius:8rpx;overflow:hidden;margin-bottom:8rpx}.membership-page .quota-card .progress-bar .progress-fill{height:100%;background:#52c41a;border-radius:8rpx;-webkit-transition:width .3s;transition:width .3s}.membership-page .quota-card .progress-bar .progress-fill.warning{background:#fa8c16}.membership-page .quota-card .quota-detail{font-size:24rpx;color:#999}.membership-page .quota-card .upgrade-tip{margin-top:16rpx;padding:16rpx;background:#fff7e6;border-radius:8rpx;text-align:center}.membership-page .quota-card .upgrade-tip Text{font-size:26rpx;color:#fa8c16}.membership-page .benefits-section{background:#fff;border-radius:16rpx;padding:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03922)}.membership-page .benefits-section .section-title{font-size:32rpx;font-weight:600;color:#333;margin-bottom:24rpx;display:block}.membership-page .benefits-section .benefit-list .benefit-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0}.membership-page .benefits-section .benefit-list .benefit-item:last-child{border-bottom:none}.membership-page .benefits-section .benefit-list .benefit-item .benefit-icon{width:40rpx;height:40rpx;background:#f6ffed;border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;font-size:24rpx;color:#52c41a}.membership-page .benefits-section .benefit-list .benefit-item .benefit-text{font-size:28rpx;color:#333}.membership-page .benefits-section .benefit-list .benefit-item.disabled .benefit-icon{background:#f5f5f5;color:#999}.membership-page .benefits-section .benefit-list .benefit-item.disabled .benefit-text{color:#999}.theme-dark .membership-page{background:-webkit-gradient(linear,left top,left bottom,from(#1c1c1c),to(#141414))!important;background:-webkit-linear-gradient(top,#1c1c1c 0%,#141414 100%)!important;background:linear-gradient(180deg,#1c1c1c 0%,#141414 100%)!important}.theme-dark .membership-page .page-title,.theme-dark .membership-page .card-title,.theme-dark .membership-page .feature-title{color:#e0e0e0!important}.theme-dark .membership-page .page-subtitle,.theme-dark .membership-page .card-desc,.theme-dark .membership-page .feature-desc,.theme-dark .membership-page .loading{color:#b0b0b0!important}.theme-dark .membership-page .membership-card,.theme-dark .membership-page .feature-card,.theme-dark .membership-page .plan-card{background:#242424!important}.theme-dark .membership-page .divider{background:#333333!important}
