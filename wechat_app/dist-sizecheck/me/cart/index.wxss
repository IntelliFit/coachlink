.cart-page{min-height:100vh;background:#f3f4f6;padding-bottom:140rpx}.cart-page .page-scroll{height:calc(100vh - 140rpx)}.cart-page .page-content{padding:24rpx}.cart-page .page-header{margin-bottom:32rpx;padding:0 8rpx}.cart-page .page-header .page-title{display:block;font-size:48rpx;font-weight:700;color:#1f2937;margin-bottom:8rpx}.cart-page .page-header .page-subtitle{display:block;font-size:26rpx;color:#6b7280}.cart-page .role-notice{background:-webkit-linear-gradient(315deg,#fff7ed 0%,#ffffff 100%);background:linear-gradient(135deg,#fff7ed 0%,#ffffff 100%);border:2rpx solid #fed7aa;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.cart-page .role-notice .role-notice-title{display:block;font-size:28rpx;font-weight:700;color:#9a3412;margin-bottom:12rpx}.cart-page .role-notice .role-notice-desc{display:block;font-size:24rpx;line-height:1.6;color:#7c2d12}.cart-page .role-notice .role-notice-link{display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;margin-top:20rpx;padding:16rpx 28rpx;border-radius:1998rpx;background:#ffffff;border:2rpx solid #fdba74;color:#c2410c;font-size:24rpx;font-weight:700}.cart-page .items-list .cart-item{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.cart-page .items-list .cart-item .item-content{margin-bottom:24rpx}.cart-page .items-list .cart-item .item-content .item-name{display:block;font-size:32rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}.cart-page .items-list .cart-item .item-content .item-badge{display:inline-block;padding:8rpx 20rpx;background:#dbeafe;color:#3b82f6;border-radius:24rpx;font-size:22rpx;font-weight:600;margin-bottom:24rpx}.cart-page .items-list .cart-item .item-content .item-info .info-text{display:block;font-size:24rpx;color:#6b7280;margin-bottom:8rpx}.cart-page .items-list .cart-item .item-content .item-info .price-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:baseline;-ms-flex-align:baseline;align-items:baseline;gap:8rpx;margin-top:16rpx}.cart-page .items-list .cart-item .item-content .item-info .price-row .price-label{font-size:26rpx;font-weight:600;color:#374151}.cart-page .items-list .cart-item .item-content .item-info .price-row .price-value{font-size:36rpx;font-weight:700;color:#f97316}.cart-page .items-list .cart-item .item-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;padding-top:24rpx;border-top:2rpx solid #f3f4f6}.cart-page .items-list .cart-item .item-actions .action-btn{-webkit-flex:1;-ms-flex:1;flex:1;padding:20rpx 0;border-radius:16rpx;text-align:center;font-size:26rpx;font-weight:600}.cart-page .items-list .cart-item .item-actions .action-btn.subscribe{background:#f97316;color:#fff;-webkit-box-shadow:0 4rpx 16rpx rgba(249,115,22,.3);box-shadow:0 4rpx 16rpx rgba(249,115,22,0.30196)}.cart-page .items-list .cart-item .item-actions .action-btn.delete{background:#f3f4f6;color:#6b7280}.cart-page .items-list .cart-item .item-actions .action-btn:active{-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.cart-page .cart-summary{background:#fff;border-radius:24rpx;padding:32rpx;margin-top:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.cart-page .cart-summary .summary-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:24rpx}.cart-page .cart-summary .summary-row .summary-label{font-size:26rpx;color:#6b7280}.cart-page .cart-summary .summary-row .summary-total{font-size:40rpx;font-weight:700;color:#f97316}.cart-page .cart-summary .summary-notice{padding:16rpx;background:#fef3c7;border-radius:12rpx;border:2rpx solid #fde68a}.cart-page .cart-summary .summary-notice .summary-notice-text{font-size:22rpx;color:#92400e;line-height:1.4}.cart-page .empty-state{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:120rpx 40rpx;min-height:800rpx}.cart-page .empty-state .empty-icon{font-size:128rpx;margin-bottom:32rpx}.cart-page .empty-state .empty-title{display:block;font-size:36rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}.cart-page .empty-state .empty-desc{display:block;font-size:26rpx;color:#6b7280;margin-bottom:48rpx;text-align:center}.cart-page .empty-state .empty-btn{padding:24rpx 64rpx;background:#f97316;color:#fff;border-radius:24rpx;font-size:28rpx;font-weight:600;-webkit-box-shadow:0 8rpx 24rpx rgba(249,115,22,.3);box-shadow:0 8rpx 24rpx rgba(249,115,22,0.30196)}.cart-page .empty-state .empty-btn:active{-webkit-transform:scale(.95);-ms-transform:scale(.95);transform:scale(.95)}.cart-page .loading-wrap{text-align:center;padding:80rpx 40rpx;color:#6b7280}
