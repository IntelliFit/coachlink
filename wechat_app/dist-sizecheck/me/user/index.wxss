.user-profile-page{min-height:100vh;background-color:#f5f5f5}.user-profile-page .loading{text-align:center;padding:48rpx;font-size:28rpx;color:#999}.user-profile-page .page-scroll{height:100vh;padding-bottom:48rpx}.user-profile-page .profile-card{background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:48rpx;text-align:center}.user-profile-page .profile-card .avatar-wrapper{width:160rpx;height:160rpx;margin:0 auto 24rpx;border-radius:50%;overflow:hidden;border:4rpx solid rgba(255,255,255,.3)}.user-profile-page .profile-card .avatar-wrapper .avatar{width:100%;height:100%}.user-profile-page .profile-card .avatar-wrapper .avatar-placeholder{width:100%;height:100%;background:rgba(255,255,255,.2);display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.user-profile-page .profile-card .avatar-wrapper .avatar-placeholder Text{font-size:64rpx;color:#fff;font-weight:600}.user-profile-page .profile-card .nickname{font-size:40rpx;font-weight:600;color:#fff;margin-bottom:8rpx;display:block}.user-profile-page .profile-card .goal{font-size:26rpx;color:rgba(255,255,255,0.8);margin-bottom:24rpx;display:block}.user-profile-page .profile-card .friend-btn{display:inline-block;padding:16rpx 48rpx;background:#fff;border-radius:32rpx}.user-profile-page .profile-card .friend-btn Text{font-size:28rpx;color:#667eea;font-weight:500}.user-profile-page .profile-card .friend-btn.friends{background:rgba(255,255,255,.3)}.user-profile-page .profile-card .friend-btn.friends Text{color:#fff}.user-profile-page .profile-card .friend-btn.pending{background:rgba(255,255,255,.2)}.user-profile-page .profile-card .friend-btn.pending Text{color:rgba(255,255,255,0.8)}.user-profile-page .stats-card,.user-profile-page .info-card{background:#fff;border-radius:16rpx;margin:24rpx;padding:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03922)}.user-profile-page .stats-card .card-title,.user-profile-page .info-card .card-title{font-size:32rpx;font-weight:600;color:#333;margin-bottom:24rpx;display:block}.user-profile-page .stats-grid{display:grid;grid-template-columns:repeat(2,1fr);grid-gap:24rpx;gap:24rpx}.user-profile-page .stats-grid .stat-item{text-align:center;padding:24rpx;background:#f8f8f8;border-radius:8rpx}.user-profile-page .stats-grid .stat-item .stat-value{font-size:40rpx;font-weight:700;color:#667eea;margin-bottom:8rpx;display:block}.user-profile-page .stats-grid .stat-item .stat-label{font-size:24rpx;color:#999}.user-profile-page .info-list .info-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0}.user-profile-page .info-list .info-item:last-child{border-bottom:none}.user-profile-page .info-list .info-item .info-label{font-size:28rpx;color:#666}.user-profile-page .info-list .info-item .info-value{font-size:28rpx;color:#333;font-weight:500}
