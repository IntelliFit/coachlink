.plan-history-detail-page{min-height:100vh;background:#f3f4f6;padding-bottom:140rpx}.plan-history-detail-page .page-scroll{height:calc(100vh - 140rpx)}.plan-history-detail-page .page-content{padding:24rpx}.plan-history-detail-page .plan-header{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.plan-history-detail-page .plan-header .plan-name{display:block;font-size:40rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}.plan-history-detail-page .plan-header .plan-desc{display:block;font-size:26rpx;color:#6b7280;line-height:1.5}.plan-history-detail-page .plan-info-section{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.plan-history-detail-page .plan-info-section .info-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:24rpx 0;border-bottom:2rpx solid #f3f4f6}.plan-history-detail-page .plan-info-section .info-item:last-child{border-bottom:none}.plan-history-detail-page .plan-info-section .info-item .info-label{font-size:28rpx;color:#6b7280}.plan-history-detail-page .plan-info-section .info-item .info-value{font-size:28rpx;font-weight:600;color:#1f2937}.plan-history-detail-page .notice-box{background:#fef3c7;border:2rpx solid #fde68a;border-radius:16rpx;padding:24rpx;margin-top:24rpx}.plan-history-detail-page .notice-box .notice-text{font-size:24rpx;color:#92400e;line-height:1.5}.plan-history-detail-page .loading-wrap,.plan-history-detail-page .empty-wrap{text-align:center;padding:80rpx 40rpx;color:#6b7280}
