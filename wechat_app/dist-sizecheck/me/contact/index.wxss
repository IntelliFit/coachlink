.doc-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);width:100%;-webkit-box-sizing:border-box;box-sizing:border-box;overflow-x:hidden}.doc-scroll{height:100vh;padding:24rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-card{background:#fff;border-radius:16rpx;padding:40rpx;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882);width:100%;max-width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-title{font-size:36rpx;font-weight:700;color:#333;margin-bottom:24rpx;display:block;word-wrap:break-word}.doc-subtitle{font-size:30rpx;font-weight:700;color:#333;margin-top:24rpx;margin-bottom:8rpx;display:block;word-wrap:break-word}.doc-content{font-size:28rpx;color:#666;line-height:1.6;margin-bottom:24rpx;display:block;text-align:justify;word-wrap:break-word;word-break:break-word}.contact-info{margin:24rpx 0;padding:24rpx;background:#f9f9f9;border-radius:8rpx}.contact-label{font-size:26rpx;color:#999;display:block;margin-top:16rpx}.contact-label:first-child{margin-top:0}.contact-value{font-size:30rpx;color:#333;display:block;margin-bottom:8rpx}.contact-hint{font-size:24rpx;color:#999;display:block;margin-top:0rpx}.contact-actions{margin-top:32rpx}.action-btn{padding:24rpx 32rpx;border-radius:8rpx;text-align:center;font-size:30rpx}.action-btn.primary{background:#1890ff;color:#fff}
