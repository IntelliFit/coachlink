.wechat-payment-page{background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);min-height:100vh;padding:96rpx 48rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.icon-wrap{width:160rpx;height:160rpx;background:#f3f4f6;border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;margin-bottom:48rpx}.icon-text{font-size:72rpx}.title{font-size:36rpx;font-weight:800;color:#1f2937;margin-bottom:24rpx}.desc{font-size:28rpx;color:#6b7280;text-align:center;margin-bottom:16rpx}.hint{font-size:26rpx;color:#9ca3af;text-align:center;margin-bottom:64rpx}.action-btn{width:100%;padding:28rpx;background:#f97316;color:#fff;font-size:30rpx;font-weight:700;text-align:center;border-radius:24rpx;margin-bottom:32rpx}.back-btn{padding:24rpx 48rpx;font-size:28rpx;color:#6b7280}
