.feedback-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%)}.feedback-scroll{height:100vh;padding:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.feedback-header{margin-bottom:24rpx}.feedback-title{font-size:40rpx;font-weight:700;color:#333;display:block}.feedback-desc{font-size:26rpx;color:#999;margin-top:8rpx;display:block}.section{margin-bottom:24rpx}.section-title{font-size:30rpx;font-weight:700;color:#333;margin-bottom:16rpx;display:block}.faq-list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.faq-item{width:calc(50% - 8rpx);padding:24rpx;background:#fff;border:2rpx solid #eee;border-radius:16rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.faq-item.active{border-color:#1890ff;background:#e6f7ff}.faq-question{font-size:26rpx;font-weight:600;color:#333;display:block;margin-bottom:8rpx}.faq-category{font-size:22rpx;color:#999}.form-card{background:#fff;border-radius:16rpx;padding:32rpx;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882)}.label{font-size:28rpx;color:#333;margin-bottom:16rpx;display:block}.selected-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:8rpx}.selected-tag{font-size:24rpx;color:#666}.clear-btn{font-size:24rpx;color:#1890ff}.textarea{width:100%;min-height:240rpx;padding:16rpx;background:#f9f9f9;border-radius:8rpx;font-size:28rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.hint{font-size:24rpx;color:#999;margin-top:16rpx;display:block}.submit-btn{margin-top:40rpx;background:#1890ff;color:#fff;border-radius:8rpx}.submit-btn[disabled]{opacity:.6}
