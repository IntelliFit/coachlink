.docs-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);width:100%;-webkit-box-sizing:border-box;box-sizing:border-box;overflow-x:hidden}.docs-scroll{height:100vh;padding:24rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-list{background:#fff;border-radius:16rpx;overflow:hidden;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882);width:100%;max-width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.list-title{font-size:32rpx;font-weight:700;color:#333;padding:32rpx;display:block;border-bottom:1rpx solid #f0f0f0;word-wrap:break-word}.doc-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;padding:32rpx;border-bottom:1rpx solid #f0f0f0;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-item:last-child{border-bottom:none}.doc-item-title{font-size:30rpx;color:#333;-webkit-flex:1;-ms-flex:1;flex:1;min-width:0;word-wrap:break-word}.doc-item-arrow{font-size:28rpx;color:#999;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;margin-left:16rpx}
