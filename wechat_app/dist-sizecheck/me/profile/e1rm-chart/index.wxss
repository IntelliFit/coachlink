.e1rm-chart-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%)}.e1rm-chart-page .page-scroll{height:100vh;padding-bottom:48rpx}.e1rm-chart-page .action-selector{background:#fff;padding:24rpx;margin-bottom:24rpx}.e1rm-chart-page .action-selector .label{font-size:28rpx;color:#666;margin-bottom:16rpx;display:block}.e1rm-chart-page .action-selector .action-list{white-space:nowrap}.e1rm-chart-page .action-selector .action-tag{display:inline-block;padding:12rpx 24rpx;background:#f5f5f5;border-radius:8rpx;margin-right:16rpx}.e1rm-chart-page .action-selector .action-tag Text{font-size:26rpx;color:#666}.e1rm-chart-page .action-selector .action-tag.selected{background:#1890ff}.e1rm-chart-page .action-selector .action-tag.selected Text{color:#fff}.e1rm-chart-page .chart-section,.e1rm-chart-page .pr-section{background:#fff;margin:0 24rpx 24rpx;border-radius:16rpx;padding:24rpx}.e1rm-chart-page .chart-section .section-title,.e1rm-chart-page .pr-section .section-title{font-size:32rpx;font-weight:600;color:#333;margin-bottom:24rpx;display:block}.e1rm-chart-page .chart-section .chart-canvas,.e1rm-chart-page .pr-section .chart-canvas{width:100%;height:400rpx}.e1rm-chart-page .chart-section .no-data,.e1rm-chart-page .pr-section .no-data{text-align:center;padding:48rpx 0}.e1rm-chart-page .chart-section .no-data Text,.e1rm-chart-page .pr-section .no-data Text{font-size:28rpx;color:#999}.e1rm-chart-page .pr-list .pr-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0}.e1rm-chart-page .pr-list .pr-item:last-child{border-bottom:none}.e1rm-chart-page .pr-list .pr-item .pr-info .pr-action{font-size:30rpx;color:#333;font-weight:500;display:block;margin-bottom:8rpx}.e1rm-chart-page .pr-list .pr-item .pr-info .pr-value{font-size:32rpx;color:#1890ff;font-weight:600;display:block;margin-bottom:4rpx}.e1rm-chart-page .pr-list .pr-item .pr-info .pr-date{font-size:24rpx;color:#999}.e1rm-chart-page .pr-list .pr-item .video-btn{padding:12rpx 24rpx;background:#f0f7ff;border-radius:8rpx}.e1rm-chart-page .pr-list .pr-item .video-btn Text{font-size:26rpx;color:#1890ff}
