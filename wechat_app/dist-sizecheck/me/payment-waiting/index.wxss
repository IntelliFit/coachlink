.payment-waiting-page{background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);min-height:100vh;padding:96rpx 64rpx 64rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.payment-waiting-header{text-align:center;margin-bottom:64rpx}.payment-waiting-header .label{font-size:20rpx;font-weight:700;letter-spacing:.2em;color:#94a3b8;text-transform:uppercase}.payment-waiting-header .amount-wrap{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:baseline;-ms-flex-align:baseline;align-items:baseline;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;gap:8rpx;margin-top:8rpx}.payment-waiting-header .amount-symbol{font-size:32rpx;font-weight:700;color:#1e293b}.payment-waiting-header .amount-value{font-size:72rpx;font-weight:900;letter-spacing:-.02em;color:#1e293b}.payment-waiting-header .order-id{font-size:24rpx;color:#94a3b8;margin-top:16rpx}.payment-waiting-card{background:#fff;border-radius:24rpx;border:2rpx solid #f1f5f9;padding:48rpx;margin-bottom:32rpx;text-align:center}.payment-waiting-spinner{position:relative;margin:0 auto 32rpx;width:96rpx;height:96rpx;background:rgba(59,130,246,.1);border-radius:24rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.payment-waiting-spinner .icon{font-size:44rpx;color:#3b82f6;-webkit-animation:spin 2s linear infinite;animation:spin 2s linear infinite}@-webkit-keyframes spin{0%{-webkit-transform:rotate(0deg);transform:rotate(0)}to{-webkit-transform:rotate(360deg);transform:rotate(360deg)}}@keyframes spin{0%{-webkit-transform:rotate(0deg);transform:rotate(0)}to{-webkit-transform:rotate(360deg);transform:rotate(360deg)}}.payment-waiting-title{font-size:34rpx;font-weight:700;color:#1e293b;margin-bottom:16rpx}.payment-waiting-hint{font-size:28rpx;color:#64748b;line-height:1.5}.payment-waiting-result .result-icon-wrap{width:120rpx;height:120rpx;margin:0 auto 32rpx;border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.payment-waiting-result .result-icon-wrap.success{background:#f0fdf4;border:2rpx solid #bbf7d0;color:#16a34a}.payment-waiting-result .result-icon-wrap.cancelled{background:#fffbeb;border:2rpx solid #fde68a;color:#d97706}.payment-waiting-result .result-icon-wrap.failed{background:#fef2f2;border:2rpx solid #fecaca;color:#dc2626}.payment-waiting-result .result-icon{font-size:56rpx;font-weight:700}.payment-waiting-result .result-title{font-size:36rpx;font-weight:700;color:#1e293b}.payment-waiting-tip{background:#fffbeb;border:2rpx solid #fde68a;border-radius:16rpx;padding:24rpx 32rpx;margin-bottom:32rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:flex-start;-ms-flex-align:start;align-items:flex-start;gap:24rpx}.payment-waiting-tip .tip-icon{font-size:36rpx;color:#d97706;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0}.payment-waiting-tip .tip-label{font-size:20rpx;font-weight:800;color:#b45309;letter-spacing:.1em;margin-bottom:8rpx}.payment-waiting-tip .tip-text{font-size:24rpx;color:#92400e;line-height:1.5}.payment-waiting-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:24rpx}.payment-waiting-btn{height:96rpx;line-height:96rpx;text-align:center;border-radius:24rpx;font-size:32rpx;font-weight:700}.payment-waiting-btn.primary{background:#3b82f6;color:#fff}.payment-waiting-btn.secondary{background:#f1f5f9;color:#64748b}.payment-waiting-btn.warn{background:#f59e0b;color:#fff}.payment-waiting-btn.danger{background:#ef4444;color:#fff}.payment-waiting-back{margin-to