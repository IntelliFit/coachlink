.purchase-history-page{min-height:100vh;background:#f3f4f6;padding-bottom:140rpx}.purchase-history-page .page-scroll{height:calc(100vh - 140rpx)}.purchase-history-page .page-content{padding:24rpx}.purchase-history-page .page-header{margin-bottom:32rpx;padding:0 8rpx}.purchase-history-page .page-header .page-title{display:block;font-size:48rpx;font-weight:700;color:#1f2937;margin-bottom:8rpx}.purchase-history-page .page-header .page-subtitle{display:block;font-size:26rpx;color:#6b7280}.purchase-history-page .purchases-list .purchase-item{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.purchase-history-page .purchases-list .purchase-item .item-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:24rpx}.purchase-history-page .purchases-list .purchase-item .item-header .item-name{-webkit-flex:1;-ms-flex:1;flex:1;font-size:32rpx;font-weight:700;color:#1f2937;margin-right:16rpx}.purchase-history-page .purchases-list .purchase-item .item-header .status-badge{padding:8rpx 20rpx;border-radius:24rpx;font-size:22rpx;font-weight:600}.purchase-history-page .purchases-list .purchase-item .item-info{margin-bottom:24rpx;padding-bottom:24rpx;border-bottom:2rpx solid #f3f4f6}.purchase-history-page .purchases-list .purchase-item .item-info .info-text{display:block;font-size:24rpx;color:#6b7280;margin-bottom:8rpx}.purchase-history-page .purchases-list .purchase-item .item-info .price-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:baseline;-ms-flex-align:baseline;align-items:baseline;gap:8rpx;margin-top:16rpx}.purchase-history-page .purchases-list .purchase-item .item-info .price-row .price-label{font-size:26rpx;font-weight:600;color:#374151}.purchase-history-page .purchases-list .purchase-item .item-info .price-row .price-value{font-size:36rpx;font-weight:700;color:#f97316}.purchase-history-page .purchases-list .purchase-item .item-footer .time-text{font-size:22rpx;color:#9ca3af}.purchase-history-page .purchases-list .load-more{text-align:center;padding:32rpx;color:#9ca3af;font-size:24rpx}.purchase-history-page .empty-state{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:120rpx 40rpx;min-height:800rpx}.purchase-history-page .empty-state .empty-icon{font-size:128rpx;margin-bottom:32rpx}.purchase-history-page .empty-state .empty-title{display:block;font-size:36rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}.purchase-history-page .empty-state .empty-desc{display:block;font-size:26rpx;color:#6b7280;text-align:center}.purchase-history-page .loading-wrap{text-align:center;padding:80rpx 40rpx;color:#6b7280}
