.coach-revenue-page{min-height:100vh;background:#f3f4f6;padding:24rpx 24rpx 160rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-revenue-page .summary{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:32rpx;margin-bottom:32rpx}.coach-revenue-page .summary .row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:16rpx}.coach-revenue-page .summary .total{font-size:36rpx;font-weight:800;color:#111827}.coach-revenue-page .list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:20rpx}.coach-revenue-page .item{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:28rpx 32rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-revenue-page .item .row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:8rpx}.coach-revenue-page .item .desc{font-size:26rpx;color:#6b7280}.coach-revenue-page .item .amount{font-size:32rpx;font-weight:700;color:#059669}.coach-revenue-page .empty-wrap,.coach-revenue-page .loading-wrap{text-align:center;padding:80rpx 40rpx;color:#9ca3af;font-size:28rpx}
