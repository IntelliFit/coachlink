:32rpx;margin-bottom:24rpx}.review-page .review-form .form-section{margin-bottom:40rpx}.review-page .review-form .form-section:last-child{margin-bottom:0}.review-page .review-form .form-section .form-label{display:block;font-size:22rpx;color:#6b7280;font-weight:700;margin-bottom:24rpx;text-transform:uppercase}.review-page .review-form .form-section .stars-container{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.review-page .review-form .form-section .stars-container.readonly .star{cursor:default;pointer-events:none}.review-page .review-form .form-section .stars-container .star{font-size:64rpx;color:#d1d5db;cursor:pointer;-webkit-transition:color .2s;transition:color .2s;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.review-page .review-form .form-section .stars-container .star.active{color:#fbbf24}.review-page .review-form .form-section .readonly-hint{display:block;font-size:24rpx;color:#9ca3af;margin-top:16rpx}.review-page .review-form .form-section .comment-input{width:100%;min-height:240rpx;padding:24rpx;border:2rpx solid #e5e7eb;border-radius:16rpx;font-size:28rpx;color:#111827;background:#fff;-webkit-box-sizing:border-box;box-sizing:border-box;line-height:1.6}.review-page .review-form .form-section .comment-input::-webkit-input-placeholder{color:#9ca3af}.review-page .review-form .form-section .comment-input::-moz-placeholder{color:#9ca3af}.review-page .review-form .form-section .comment-input:-ms-input-placeholder{color:#9ca3af}.review-page .review-form .form-section .comment-input::-ms-input-placeholder{color:#9ca3af}.review-page .review-form .form-section .comment-input::placeholder{color:#9ca3af}.review-page .review-form .form-section .comment-input.readonly{background:#f9fafb;color:#6b7280;cursor:not-allowed}.review-page .submit-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:24rpx 32rpx;border-top:2rpx solid #e5e7e