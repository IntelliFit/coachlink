.plan-detail-entry-page{min-height:100vh;background:#f3f4f6;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:48rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.plan-detail-entry-page .entry-card{width:100%;max-width:1120rpx;background:#fff;border-radius:28rpx;border:2rpx solid #e5e7eb;padding:40rpx;-webkit-box-sizing:border-box;box-sizing:border-box;text-align:center}.plan-detail-entry-page .entry-title{display:block;font-size:36rpx;font-weight:700;color:#111827;margin-bottom:16rpx}.plan-detail-entry-page .entry-desc{display:block;font-size:26rpx;color:#6b7280}.plan-detail-entry-page .entry-error{display:block;font-size:26rpx;color:#b91c1c}
