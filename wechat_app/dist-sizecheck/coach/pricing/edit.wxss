.pricing-edit-page{min-height:100vh;background:#f3f4f6;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;padding-bottom:160rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.pricing-edit-page .edit-scroll{-webkit-flex:1;-ms-flex:1;flex:1;height:calc(100vh - 160rpx)}.pricing-edit-page .form-section{padding:32rpx}.pricing-edit-page .form-item{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.pricing-edit-page .form-label{display:block;font-size:28rpx;font-weight:600;color:#374151;margin-bottom:20rpx}.pricing-edit-page .form-label-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:20rpx}.pricing-edit-page .form-input{width:100%;min-height:88rpx;padding:24rpx;background:#f9fafb;border:2rpx solid #e5e7eb;border-radius:16rpx;font-size:30rpx;line-height:40rpx;-webkit-box-sizing:border-box;box-sizing:border-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.pricing-edit-page .form-textarea{width:100%;min-height:200rpx;padding:24rpx;background:#f9fafb;border:2rpx solid #e5e7eb;border-radius:16rpx;font-size:30rpx;line-height:44rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.pricing-edit-page .picker-view{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;min-height:88rpx;padding:24rpx;background:#f9fafb;border:2rpx solid #e5e7eb;border-radius:16rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.pricing-edit-page .picker-text{font-size:30rpx;color:#111827;line-height:40rpx;-webkit-flex:1;-ms-flex:1;flex:1}.pricing-edit-page .picker-arrow{font-size:40rpx;color:#9ca3af}.pricing-edit-page .add-btn{background:#3b82f6;color:#fff;border:none;border-radius:12rpx;padding:8rpx 24rpx;font-size:24rpx}.pricing-edit-page .duration-options{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:20rpx}.pricing-edit-page .duration-option{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:16rpx;padding:24rpx;background:#f9fafb;border:2rpx solid #e5e7eb;border-radius:16rpx}.pricing-edit-page .duration-input-group{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-flex:1;-ms-flex:1;flex:1;gap:8rpx}.pricing-edit-page .duration-input{-webkit-flex:1;-ms-flex:1;flex:1;min-height:80rpx;padding:20rpx 24rpx;background:#fff;border:2rpx solid #d1d5db;border-radius:12rpx;font-size:28rpx;line-height:40rpx;-webkit-box-sizing:border-box;box-sizing:border-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.pricing-edit-page .price-input{text-align:right;font-weight:600}.pricing-edit-page .duration-unit{font-size:28rpx;color:#6b7280;white-space:nowrap}.pricing-edit-page .remove-btn{background:#ef4444;color:#fff;border:none;border-radius:12rpx;padding:8rpx 24rpx;font-size:24rpx}.pricing-edit-page .footer-actions{position:fixed;bottom:0;left:0;right:0;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx;padding:24rpx 32rpx;background:#fff;border-top:2rpx solid #e5e7eb;-webkit-box-shadow:0 -4rpx 16rpx rgba(0,0,0,.05);box-shadow:0 -4rpx 16rpx rgba(0,0,0,0.05098);-webkit-box-sizing:border-box;box-sizing:border-box;z-index:100}.pricing-edit-page .cancel-btn{-webkit-flex:1;-ms-flex:1;flex:1;background:#f3f4f6;color:#374151;border:none;border-radius:16rpx;padding:24rpx;font-size:30rpx;font-weight:600}.pricing-edit-page .save-btn{-webkit-flex:1;-ms-flex:1;flex:1;background:#3b82f6;color:#fff;border:none;border-radius:16rpx;padding:24rpx;font-size:30rpx;font-weight:600}
