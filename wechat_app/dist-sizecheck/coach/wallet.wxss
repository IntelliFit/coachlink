.coach-wallet-page{min-height:100vh;background:#f3f4f6}.coach-wallet-page .loading-wrap{padding:48rpx;text-align:center;color:#9ca3af;font-size:28rpx}.coach-wallet-page .wallet-scroll{padding:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-wallet-page .balance-card{background:-webkit-linear-gradient(315deg,#10b981 0%,#059669 100%);background:linear-gradient(135deg,#10b981 0%,#059669 100%);border-radius:32rpx;padding:48rpx;margin:0 24rpx 32rpx;color:#fff;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-wallet-page .balance-card .label{font-size:28rpx;opacity:.9;margin-bottom:16rpx;display:block}.coach-wallet-page .balance-card .amount{font-size:72rpx;font-weight:800;display:block;margin-bottom:24rpx}.coach-wallet-page .balance-card .frozen-amount,.coach-wallet-page .balance-card .total-income{font-size:24rpx;opacity:.8;display:block;margin-top:8rpx}.coach-wallet-page .transactions-section{background:#fff;border-radius:32rpx;padding:32rpx;margin:0 24rpx 32rpx;border:2rpx solid #e5e7eb;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-wallet-page .transactions-section .section-title{font-size:32rpx;font-weight:800;color:#111827;margin-bottom:32rpx;display:block}.coach-wallet-page .transactions-section .transaction-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:flex-start;-ms-flex-align:start;align-items:flex-start;padding:24rpx 0;border-bottom:2rpx solid #f3f4f6;cursor:pointer}.coach-wallet-page .transactions-section .transaction-item:last-child{border-bottom:none}.coach-wallet-page .transactions-section .transaction-item .transaction-left{-webkit-flex:1;-ms-flex:1;flex:1;min-width:0}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-type{display:inline-block;padding:4rpx 16rpx;border-radius:8rpx;font-size:22rpx;font-weight:600;margin-bottom:12rpx}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-type.income{background:#ecfdf5;color:#059669}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-type.withdrawal{background:#fef3c7;color:#d97706}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-type.refund{background:#fee2e2;color:#dc2626}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-desc{font-size:28rpx;color:#111827;font-weight:600;margin-bottom:8rpx;display:block;word-break:break-all}.coach-wallet-page .transactions-section .transaction-item .transaction-left .transaction-time{font-size:24rpx;color:#9ca3af;display:block}.coach-wallet-page .transactions-section .transaction-item .transaction-amount{font-size:32rpx;font-weight:800;font-family:monospace}.coach-wallet-page .transactions-section .transaction-item .transaction-amount.income{color:#10b981}.coach-wallet-page .transactions-section .transaction-item .transaction-amount.outcome{color:#111827}.coach-wallet-page .empty-transactions{background:#fff;border-radius:32rpx;padding:80rpx 40rpx;text-align:center;margin:0 24rpx 32rpx;border:2rpx solid #e5e7eb;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-wallet-page .empty-transactions .empty-text{font-size:28rpx;color:#9ca3af}.coach-wallet-page .hint-card{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:32rpx;margin:0 24rpx 32rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-wallet-page .hint-card .hint-text{font-size:28rpx;color:#6b7280;text-align:center;line-height:1.6}
