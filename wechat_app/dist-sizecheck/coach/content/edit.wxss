;padding:40rpx;background:#f5f5f5;border-radius:24rpx;font-size:56rpx;border:none}.coach-content-edit-page .form-item .tag-input-group .add-tag-btn{padding:0 60rpx;background:#007aff;color:#fff;border-radius:24rpx;font-size:56rpx;border:none}.coach-content-edit-page .form-item .tags-list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:24rpx}.coach-content-edit-page .form-item .tags-list .tag-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:16rpx;padding:24rpx 40rpx;background:#e3f2fd;border-radius:40rpx}.coach-content-edit-page .form-item .tags-list .tag-item .tag-text{font-size:48rpx;color:#1976d2}.coach-content-edit-page .form-item .tags-list .tag-item .tag-remove{font-size:64rpx;color:#1976d2;line-height:1;cursor:pointer}.coach-content-edit-page .form-item .checkbox-group .checkbox-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:32rpx}.coach-content-edit-page .form-item .checkbox-group .checkbox-item .checkbox{width:80rpx;height:80rpx;border:4rpx solid #ddd;border-radius:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.coach-content-edit-page .form-item .checkbox-group .checkbox-item .checkbox.checked{background:#007aff;border-color:#007aff}.coach-content-edit-page .form-item .checkbox-group .checkbox-item .checkbox.checked .checkbox-icon{color:#fff;font-size:56rpx}.coach-content-edit-page .form-item .checkbox-group .checkbox-item .checkbox-label{font-size:56rpx;color:#333}.coach-content-edit-page .footer{position:fixed;bottom:0;left:0;right:0;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:40rpx;padding:40rpx;background:#fff;border-top:2rpx solid #eee}.coach-content-edit-page .footer .draft-btn,.coach-content-edit-page .footer .publish-btn{-webkit-flex:1;-ms-flex:1;flex:1;padding:48rpx;border-radius:24rpx;font-size:64rpx;border:none}.coach-content-edit-page .footer .draft-btn{background:#f5f5f5;color:#333}.coach-content-edit-page .footer .publish-btn{background:#007aff;color:#fff}
