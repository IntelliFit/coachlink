.coach-videos-page{min-height:100vh;background:#f3f4f6;padding:180rpx 24rpx 160rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-videos-page .filter-bar{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;margin-bottom:24rpx;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap}.coach-videos-page .filter-bar .filter-btn{padding:12rpx 24rpx;border-radius:40rpx;font-size:26rpx;background:#fff;border:2rpx solid #e5e7eb;color:#6b7280}.coach-videos-page .filter-bar .filter-btn.active{background:#fef3c7;border-color:#f59e0b;color:#b45309}.coach-videos-page .video-list{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:20rpx}.coach-videos-page .video-card{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:24rpx 28rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.coach-videos-page .video-card .card-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:12rpx}.coach-videos-page .video-card .student-name{font-size:30rpx;font-weight:700;color:#111827}.coach-videos-page .video-card .status-tag{font-size:22rpx;padding:4rpx 16rpx;border-radius:1998rpx;background:#fef3c7;color:#b45309}.coach-videos-page .video-card .status-tag.reviewed{background:#d1fae5;color:#059669}.coach-videos-page .video-card .exercise-name{font-size:26rpx;color:#6b7280;margin-bottom:8rpx}.coach-videos-page .video-card .card-actions{margin-top:24rpx;padding-top:24rpx;border-top:2rpx solid #f3f4f6}.coach-videos-page .video-card .review-btn{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;gap:12rpx;padding:20rpx 32rpx;background:#3b82f6;border-radius:16rpx;-webkit-box-shadow:0 4rpx 16rpx rgba(59,130,246,.25);box-shadow:0 4rpx 16rpx rgba(59,130,246,0.25098);-webkit-transition:all .2s ease;transition:all .2s ease;cursor:pointer;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.coach-videos-page .video-card .review-btn:active{-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98);-webkit-box-shadow:0 2rpx 8rpx rgba(59,130,246,.3);box-shadow:0 2rpx 8rpx rgba(59,130,246,0.30196)}.coach-videos-page .video-card .review-btn.reviewed-btn{background:#10b981;-webkit-box-shadow:0 4rpx 16rpx rgba(16,185,129,.25);box-shadow:0 4rpx 16rpx rgba(16,185,129,0.25098)}.coach-videos-page .video-card .review-btn.reviewed-btn:active{-webkit-box-shadow:0 2rpx 8rpx rgba(16,185,129,.3);box-shadow:0 2rpx 8rpx rgba(16,185,129,0.30196)}.coach-videos-page .video-card .review-btn .review-btn-text{font-size:30rpx;font-weight:700;color:#fff;letter-spacing:1rpx}.coach-videos-page .video-card .review-btn .review-btn-icon{font-size:36rpx;font-weight:700;color:#fff;margin-left:4rpx;-webkit-transition:-webkit-transform .2s ease;transition:-webkit-transform .2s ease;transition:transform .2s ease;transition:transform .2s ease, -webkit-transform .2s ease}.coach-videos-page .video-card .review-btn:active .review-btn-icon{-webkit-transform:translateX(4rpx);-ms-transform:translateX(4rpx);transform:translate(4rpx)}.coach-videos-page .empty-wrap{text-align:center;padding:80rpx 40rpx;color:#9ca3af;font-size:28rpx}.coach-videos-page .loading-wrap{padding:48rpx;text-align:center;color:#9ca3af;font-size:28rpx}
