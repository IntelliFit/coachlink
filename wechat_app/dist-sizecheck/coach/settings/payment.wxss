.payment-settings-page{min-height:100vh;background:#f3f4f6;-webkit-box-sizing:border-box;box-sizing:border-box}.payment-settings-page .loading-wrap{padding:48rpx;text-align:center;color:#9ca3af;font-size:28rpx}.payment-settings-page .settings-scroll{padding:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.payment-settings-page .settings-card{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:48rpx;margin-bottom:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%;overflow:hidden}.payment-settings-page .settings-card .card-title{font-size:36rpx;font-weight:800;color:#111827;margin-bottom:40rpx;display:block}.payment-settings-page .settings-card .qrcode-section{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%}.payment-settings-page .settings-card .qrcode-section .qrcode-image{width:400rpx;max-width:100%;height:400rpx;border-radius:24rpx;margin-bottom:32rpx;border:2rpx solid #e5e7eb;-webkit-box-sizing:border-box;box-sizing:border-box}.payment-settings-page .settings-card .qrcode-section .qrcode-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%}.payment-settings-page .settings-card .qrcode-section .qrcode-actions .update-btn,.payment-settings-page .settings-card .qrcode-section .qrcode-actions .delete-btn{-webkit-flex:1;-ms-flex:1;flex:1;min-width:0;padding:24rpx;border-radius:16rpx;font-size:28rpx;font-weight:500;border:none;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%}.payment-settings-page .settings-card .qrcode-section .qrcode-actions .update-btn{background:#3b82f6;color:#fff}.payment-settings-page .settings-card .qrcode-section .qrcode-actions .delete-btn{background:#ef4444;color:#fff}.payment-settings-page .settings-card .empty-section{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:80rpx 40rpx;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%}.payment-settings-page .settings-card .empty-section .empty-text{font-size:28rpx;color:#9ca3af;margin-bottom:40rpx;text-align:center}.payment-settings-page .settings-card .empty-section .upload-btn{padding:24rpx 48rpx;background:#3b82f6;color:#fff;border-radius:16rpx;font-size:28rpx;font-weight:500;border:none;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%}.payment-settings-page .hint-card{background:#fff;border:2rpx solid #e5e7eb;border-radius:32rpx;padding:40rpx;margin-top:24rpx;-webkit-box-sizing:border-box;box-sizing:border-box;max-width:100%;overflow:hidden}.payment-settings-page .hint-card .hint-title{font-size:28rpx;font-weight:600;color:#111827;margin-bottom:24rpx;display:block}.payment-settings-page .hint-card .hint-text{font-size:24rpx;color:#6b7280;line-height:1.8;display:block;margin-bottom:8rpx}.payment-settings-page .hint-card .hint-text:last-child{margin-bottom:0}
