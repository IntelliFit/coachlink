.node-detail-page{min-height:100vh;background:#f3f4f6;padding-bottom:80rpx}.node-detail-page .nav-bar{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:24rpx 32rpx;background:#fff;border-bottom:2rpx solid #e5e7eb}.node-detail-page .nav-bar .nav-back{font-size:30rpx;color:#f28631;margin-right:24rpx}.node-detail-page .nav-bar .nav-title{-webkit-flex:1;-ms-flex:1;flex:1;font-size:34rpx;font-weight:700;color:#111827;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.node-detail-page .loading-wrap,.node-detail-page .error-wrap{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:96rpx 48rpx}.node-detail-page .loading-wrap .error-icon,.node-detail-page .error-wrap .error-icon{font-size:96rpx;margin-bottom:24rpx}.node-detail-page .loading-wrap .error-text,.node-detail-page .error-wrap .error-text{font-size:30rpx;color:#6b7280;margin-bottom:32rpx}.node-detail-page .loading-wrap .error-action,.node-detail-page .error-wrap .error-action{font-size:28rpx;color:#f28631;font-weight:600}.node-detail-page .content-scroll{height:calc(100vh - 100rpx)}.node-detail-page .node-body{padding:40rpx 32rpx;background:#fff;margin:24rpx;border-radius:24rpx;border:2rpx solid #e5e7eb}.node-detail-page .node-type-badge{display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:12rpx;padding:8rpx 20rpx;background:#FFF5EB;color:#f28631;font-size:24rpx;font-weight:600;border-radius:12rpx;margin-bottom:24rpx}.node-detail-page .node-title{font-size:40rpx;font-weight:800;color:#111827;display:block;margin-bottom:16rpx;line-height:1.4}.node-detail-page .node-desc{font-size:28rpx;color:#6b7280;line-height:1.6;display:block;margin-bottom:24rpx}.node-detail-page .node-tags{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx;margin-bottom:32rpx}.node-detail-page .node-tags .node-tag{font-size:22rpx;padding:8rpx 16rpx;background:#fce7f3;color:#be185d;border-radius:12rpx}.node-detail-page .video-wrap{margin-bottom:40rpx;border-radius:16rpx;overflow:hidden;background:#000}.node-detail-page .video-wrap .node-video{width:100%;height:400rpx}.node-detail-page .content-html{font-size:30rpx;line-height:1.8;color:#374151}.node-detail-page .content-html rich-text{word-break:break-word}.node-detail-page .content-fallback{font-size:28rpx;color:#6b7280;line-height:1.6}.node-detail-page .related-articles{margin-top:48rpx;padding-top:40rpx;border-top:2rpx solid #e5e7eb}.node-detail-page .related-articles .related-title{font-size:32rpx;font-weight:700;color:#111827;margin-bottom:24rpx;display:block}.node-detail-page .related-articles .article-item{padding:24rpx 0;border-bottom:2rpx solid #f3f4f6}.node-detail-page .related-articles .article-item:last-child{border-bottom:none}.node-detail-page .related-articles .article-item .article-item-title{font-size:30rpx;font-weight:600;color:#111827;display:block;margin-bottom:8rpx}.node-detail-page .related-articles .article-item .article-item-author{font-size:24rpx;color:#9ca3af}
