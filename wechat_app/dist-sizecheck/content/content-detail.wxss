.content-detail-page{min-height:100vh;background:#f5f5f5}.content-detail-page .nav-bar{position:-webkit-sticky;position:sticky;top:0;z-index:10;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;height:88rpx;padding:0 32rpx;background:#fff;border-bottom:2rpx solid #eee}.content-detail-page .nav-bar .nav-back{color:#1989fa;font-size:30rpx;margin-right:24rpx}.content-detail-page .nav-bar .nav-title{-webkit-flex:1;-ms-flex:1;flex:1;font-size:34rpx;font-weight:600;color:#333}.content-detail-page .loading-wrap,.content-detail-page .error-wrap,.content-detail-page .paywall-wrap{padding:120rpx 48rpx;text-align:center}.content-detail-page .error-wrap .error-icon{font-size:96rpx;display:block;margin-bottom:24rpx}.content-detail-page .error-wrap .error-text{display:block;color:#666;font-size:28rpx;margin-bottom:40rpx}.content-detail-page .error-wrap .error-action{color:#1989fa;font-size:28rpx}.content-detail-page .paywall-wrap .paywall-icon{font-size:112rpx;margin-bottom:32rpx}.content-detail-page .paywall-wrap .paywall-title{display:block;font-size:36rpx;font-weight:600;color:#333;margin-bottom:16rpx}.content-detail-page .paywall-wrap .paywall-desc{display:block;font-size:28rpx;color:#666;margin-bottom:48rpx;line-height:1.5}.content-detail-page .paywall-wrap .paywall-btn{display:inline-block;padding:24rpx 64rpx;background:#1989fa;color:#fff;border-radius:16rpx;font-size:30rpx}.content-detail-page .content-scroll{height:calc(100vh - 88rpx)}.content-detail-page .content-body{padding:32rpx;background:#fff;margin:24rpx;border-radius:24rpx}.content-detail-page .content-body .content-title{display:block;font-size:40rpx;font-weight:700;color:#333;margin-bottom:24rpx;line-height:1.4}.content-detail-page .content-body .content-meta{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:32rpx;font-size:24rpx;color:#999;margin-bottom:32rpx}.content-detail-page .content-body .content-media{margin-bottom:32rpx}.content-detail-page .content-body .content-media .media-item{margin-bottom:24rpx;border-radius:16rpx;overflow:hidden;background:#000}.content-detail-page .content-body .content-media .media-video{width:100%;height:400rpx}.content-detail-page .content-body .content-media .media-img{width:100%;display:block}.content-detail-page .content-body .content-html{font-size:30rpx;color:#333;line-height:1.7;word-break:break-word}.content-detail-page .content-body .content-html image{max-width:100%;height:auto}.content-detail-page .content-body .content-tags{margin-top:40rpx;padding-top:32rpx;border-top:2rpx solid #eee;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.content-detail-page .content-body .content-tags .tag{font-size:24rpx;color:#1989fa;background:#e8f4ff;padding:8rpx 20rpx;border-radius:8rpx}
