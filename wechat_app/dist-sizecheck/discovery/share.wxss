.share-page{min-height:100vh;background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:48rpx 24rpx}.share-page .loading{text-align:center;padding:48rpx;font-size:28rpx;color:#fff}.share-page .preview-card{background:#fff;border-radius:24rpx;padding:48rpx;margin-bottom:48rpx;-webkit-box-shadow:0 20rpx 60rpx rgba(0,0,0,.2);box-shadow:0 20rpx 60rpx rgba(0,0,0,0.2)}.share-page .preview-card .card-header{text-align:center;margin-bottom:48rpx}.share-page .preview-card .card-header .title{font-size:48rpx;font-weight:700;color:#333;margin-bottom:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.share-page .preview-card .card-header .subtitle{font-size:32rpx;color:#666;margin-bottom:8rpx;display:block}.share-page .preview-card .card-header .date{font-size:24rpx;color:#999}.share-page .preview-card .stats-section .main-stat{text-align:center;padding:48rpx 0;border-bottom:2rpx solid #f0f0f0;margin-bottom:32rpx}.share-page .preview-card .stats-section .main-stat .value{font-size:80rpx;font-weight:800;color:#667eea;margin-bottom:8rpx;display:block}.share-page .preview-card .stats-section .main-stat .label{font-size:28rpx;color:#999}.share-page .preview-card .stats-section .sub-stats{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-around;-ms-flex-pack:distribute;justify-content:space-around}.share-page .preview-card .stats-section .sub-stats .sub-stat{text-align:center}.share-page .preview-card .stats-section .sub-stats .sub-stat.highlight .value{color:#fa8c16}.share-page .preview-card .stats-section .sub-stats .sub-stat .value{font-size:48rpx;font-weight:700;color:#333;margin-bottom:8rpx;display:block}.share-page .preview-card .stats-section .sub-stats .sub-stat .label{font-size:24rpx;color:#999}.share-page .preview-card .footer{text-align:center;margin-top:48rpx;padding-top:32rpx;border-top:2rpx solid #f0f0f0}.share-page .preview-card .footer Text{font-size:24rpx;color:#999}.share-page .share-actions .share-btn{padding:24rpx 0;border-radius:16rpx;text-align:center;margin-bottom:24rpx;background:#fff}.share-page .share-actions .share-btn Text{font-size:32rpx;font-weight:600;color:#667eea}.share-page .share-actions .share-btn.loading{opacity:.7}.share-page .share-actions .share-btn.secondary{background:rgba(255,255,255,.2)}.share-page .share-actions .share-btn.secondary Text{color:#fff}.share-page .share-actions .share-btn:active{opacity:.9}
