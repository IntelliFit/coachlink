.wechat-auth-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:48rpx}.card{background:#fff;border-radius:16rpx;padding:48rpx;text-align:center;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882)}.title{font-size:36rpx;font-weight:700;color:#333;display:block;margin-bottom:24rpx}.desc{font-size:28rpx;color:#666;line-height:1.6;display:block;margin-bottom:32rpx}.btn{padding:24rpx 48rpx;background:#07c160;color:#fff;border-radius:8rpx;font-size:30rpx}
