.onboarding-page{min-height:100vh;background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);width:100%;-webkit-box-sizing:border-box;box-sizing:border-box;overflow-x:hidden}.onboarding-scroll{height:100vh;padding:24rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-card{background:#fff;border-radius:16rpx;padding:40rpx;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882);width:100%;max-width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.doc-title{font-size:36rpx;font-weight:700;color:#333;margin-bottom:24rpx;display:block;word-wrap:break-word}.doc-content{font-size:28rpx;color:#666;line-height:1.6;margin-bottom:24rpx;display:block;text-align:justify;word-wrap:break-word;word-break:break-word}.actions{margin-top:32rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:24rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box}.btn{padding:24rpx;border-radius:8rpx;text-align:center;font-size:30rpx;width:100%;-webkit-box-sizing:border-box;box-sizing:border-box;word-wrap:break-word}.btn.primary{background:#1890ff;color:#fff}.btn.secondary{background:#f5f5f5;color:#333;border:1rpx solid #e0e0e0}
