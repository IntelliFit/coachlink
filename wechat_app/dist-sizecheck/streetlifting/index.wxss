.streetlifting-page{background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);min-height:100vh;background:#f5f5f5}.streetlifting-scroll{height:100vh;padding:24rpx}.hero{margin-bottom:32rpx}.hero .hero-title{font-size:40rpx;font-weight:700;color:#333;display:block;margin-bottom:8rpx}.hero .hero-desc{font-size:28rpx;color:#666;line-height:1.5}.stats-card{background:#fff;border-radius:16rpx;padding:32rpx;margin-bottom:24rpx;text-align:center;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882)}.stats-card .stats-value{font-size:48rpx;font-weight:700;color:#1890ff;display:block}.stats-card .stats-label{font-size:28rpx;color:#666}.stats-card .stats-meta{font-size:24rpx;color:#999;margin-top:8rpx;display:block}.stats-card .stats-loading{font-size:28rpx;color:#999}.nav-grid{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.nav-item{width:calc(50% - 8rpx);background:#fff;border-radius:16rpx;padding:24rpx;-webkit-box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05882)}.nav-item.primary{background:#1890ff}.nav-item .nav-icon{font-size:40rpx;display:block;margin-bottom:8rpx}.nav-item .nav-text{font-size:28rpx;color:#333}.nav-item.primary .nav-text{color:#fff}.web-hint{margin-top:32rpx;padding:24rpx;font-size:24rpx;color:#999;text-align:center}
