.success-page{background:-webkit-gradient(linear,left top,left bottom,from(#E8E8E8),to(#F8F8F8));background:-webkit-linear-gradient(top,#E8E8E8 0%,#F8F8F8 100%);background:linear-gradient(180deg,#E8E8E8 0%,#F8F8F8 100%);min-height:100vh;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:48rpx;background:#f5f5f5}.success-icon{font-size:80rpx;margin-bottom:24rpx}.success-title{font-size:36rpx;font-weight:700;color:#333;margin-bottom:12rpx}.success-desc{font-size:28rpx;color:#666;margin-bottom:48rpx}.btn{padding:24rpx 48rpx;background:#1890ff;color:#fff;border-radius:12rpx;font-size:30rpx}
