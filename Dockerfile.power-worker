FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV POWER_ANALYSIS_PYTHON_BIN=python3

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      ffmpeg \
      libgl1 \
      libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json ./

RUN python3 -m venv /opt/power-analysis-venv && \
    /opt/power-analysis-venv/bin/pip install --no-cache-dir -r scripts/power-analysis/requirements.txt

ENV POWER_ANALYSIS_PYTHON_BIN=/opt/power-analysis-venv/bin/python

CMD ["node", "scripts/power-analysis-worker.mjs", "--queue"]
