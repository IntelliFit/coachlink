FROM node:22-bookworm-slim AS node-runtime

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV NODE_ENV=production
ENV POWER_ANALYSIS_PYTHON_BIN=python3

RUN apt-get update && \
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      ca-certificates \
      curl \
      ffmpeg \
      fonts-noto-cjk \
      libgl1 \
      libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY scripts ./scripts
COPY src ./src
COPY packages ./packages
COPY tsconfig.json ./

RUN python3 -m venv /opt/power-analysis-venv && \
    /opt/power-analysis-venv/bin/pip install --no-cache-dir -r scripts/power-analysis/requirements.txt

ENV POWER_ANALYSIS_PYTHON_BIN=/opt/power-analysis-venv/bin/python

CMD ["node", "scripts/power-analysis-worker.mjs", "--queue"]
