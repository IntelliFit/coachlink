{
  "expo": {
    "name": "CoachLink",
    "slug": "coachlink-mobile",
    "scheme": "coachlink",
    "version": "0.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cn.coachlink.app"
    },
    "android": {
      "package": "cn.coachlink.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F5F3"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 CoachLink 访问相册，以选择头像、训练素材和街健点位图片。",
          "cameraPermission": "允许 CoachLink 使用相机，以拍摄头像、训练素材和街健点位图片。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 CoachLink 访问相册以选择训练视频。",
          "savePhotosPermission": "允许 CoachLink 将功率分析结果视频保存到相册。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 CoachLink 获取你的位置，以查找附近的单杠和在地图上标记单杠位置。只在使用这些功能时获取，不会保存到 CoachLink 的服务器。",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#CF6D4E",
          "defaultChannel": "messages"
        }
      ],
      "expo-asset"
    ]
  }
}
