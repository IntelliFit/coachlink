# Copy to .env.weapp-release.local and fill local secrets.

# Defaults to project.config.json appid when omitted.
WEAPP_APPID=wx316e39eb71c0e834

# Download from WeChat MP Console -> Development -> Development Settings -> Mini Program upload key.
# Keep this file outside Git, or place it under wechat_app/private.<appid>.key.
WEAPP_UPLOAD_PRIVATE_KEY_PATH=D:\secure\private.wx316e39eb71c0e834.key

# Required for submit audit, audit status polling, release, category lookup, and page lookup.
WEAPP_APP_SECRET=

# CI robot 1-30.
WEAPP_CI_ROBOT=1

# Optional release behavior.
WEAPP_AUDIT_CONFIG=release.weapp.json
WEAPP_AUDIT_POLL_INTERVAL_MS=60000
WEAPP_AUDIT_POLL_TIMEOUT_MS=7200000

# Set to 1 when you want `npm run release:auto` to publish after audit passes.
# `npm run release:full` passes --release and does not need this flag.
WEAPP_AUTO_RELEASE=0

# Optional gray release percentage. Omit or set 0 for full release.
WEAPP_GRAY_PERCENTAGE=0
