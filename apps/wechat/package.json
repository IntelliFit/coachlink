{
  "name": "@coachlink/wechat",
  "version": "1.0.0",
  "private": true,
  "description": "coachlink wechat app",
  "templateInfo": {
    "name": "react-NutUI",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "node scripts/build-weapp.js local",
    "build:weapp:release": "node scripts/build-weapp.js release",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "node scripts/dev-weapp-with-fixes.js local",
    "dev:weapp:lan": "node scripts/dev-weapp-with-fixes.js lan",
    "release:upload": "node scripts/weapp-release.js upload",
    "release:audit": "node scripts/weapp-release.js audit",
    "release:status": "node scripts/weapp-release.js status",
    "release:wait-audit": "node scripts/weapp-release.js wait-audit",
    "release:publish": "node scripts/weapp-release.js publish",
    "release:auto": "node scripts/weapp-release.js auto",
    "release:full": "node scripts/weapp-release.js auto --release",
    "release:categories": "node scripts/weapp-release.js categories",
    "release:pages": "node scripts/weapp-release.js pages",
    "fix:weapp-wxml": "node scripts/fix-weapp-wxml.js",
    "fix:weapp-comp": "node scripts/fix-weapp-comp-path.js",
    "copy:comp": "node scripts/copy-comp-to-subpackages.js",
    "ensure:weapp-comp": "node -e \"require('./scripts/ensure-root-comp-artifacts').ensureRootCompArtifacts(require('path').join(process.cwd(), process.env.WEAPP_OUTPUT_ROOT||'dist'))\"",
    "dev:weapp:simulator": "node scripts/dev-weapp-with-fixes.js local",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@nutui/nutui-react-taro": "^2.6.14",
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-html": "4.1.11",
    "@tarojs/plugin-platform-alipay": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-jd": "4.1.11",
    "@tarojs/plugin-platform-qq": "4.1.11",
    "@tarojs/plugin-platform-swan": "4.1.11",
    "@tarojs/plugin-platform-tt": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "lucide-react": "^0.563.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.1.11",
    "@tarojs/vite-runner": "4.1.11",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.1.11",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.12.0",
    "eslint-config-taro": "4.1.11",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "miniprogram-ci": "^2.1.31",
    "postcss": "^8.4.18",
    "react-refresh": "^0.14.0",
    "sass": "^1.60.0",
    "stylelint": "^14.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.16.8",
    "typescript": "^5.1.0",
    "vite": "^4.5.0",
    "vite-plugin-imp": "^2.4.0",
    "weapp-tailwindcss": "^4.9.2"
  }
}
