{
    "name": "coachlink",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "node scripts/start-dev.mjs",
        "build": "node scripts/build-prod.js",
        "start": "node scripts/start-prod.mjs",
        "dev:custom": "node scripts/start-dev.mjs",
        "lint": "node -e \"console.log('Lint 未配置：Next v16 已移除 next lint，且项目未安装 eslint。可运行 npm run typecheck（当前会暴露历史类型错误）。')\"",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "check-env": "node scripts/check-env.js",
        "test": "vitest run",
        "test:report": "xunit-viewer -r test-results/vitest/junit.xml -o test-results/vitest/report.html",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:redis": "tsx scripts/test-redis.ts",
        "optimize-favicon": "python scripts/optimize-favicon.py",
        "check-vapid": "tsx scripts/check-vapid.ts",
        "test-push": "tsx scripts/test-push.ts",
        "pre-deploy-check": "node scripts/pre-deploy-check.js",
        "context-preview-report": "npx tsx scripts/context-preview-report.ts",
        "migrate:supabase-to-pg": "npx tsx scripts/migrate-supabase-to-postgres.ts",
        "migrate:storage-to-cos": "npx tsx scripts/migrate-supabase-storage-to-cos.ts",
        "replace:storage-urls": "npx tsx scripts/replace-storage-urls.ts",
        "canonical-actions:reference-images": "npx tsx scripts/generate-canonical-action-reference-images.ts",
        "canonical-actions:import-street-workout": "npx tsx scripts/import-street-workout-actions.ts",
        "canonical-actions:backfill-community-links": "npx tsx scripts/backfill-community-action-canonical-links.ts",
        "canonical-actions:backfill-fallback-images": "npx tsx scripts/backfill-canonical-reference-fallbacks.ts",
        "canonical-actions:bootstrap-from-community": "npx tsx scripts/bootstrap-canonical-actions-from-community.ts",
        "training-plans:collect": "node scripts/training-plan-collector.mjs",
        "training-plans:collect:full": "node scripts/training-plan-collector.mjs --download-assets",
        "training-plans:collect:retry-boostcamp": "node scripts/training-plan-collector.mjs --sources boostcamp --retry-failures --concurrency 1 --delay-ms 1200",
        "training-plans:summarize": "node scripts/summarize-training-plan-corpus.mjs",
        "training-plans:select-200": "node scripts/select-training-plan-candidates.mjs --limit 200",
        "training-plans:audit-200": "node scripts/audit-training-plan-candidates.mjs",
        "training-plans:verify-pipeline": "node scripts/verify-training-plan-pipeline.mjs",
        "knowledge-books:sync-neijing": "tsx scripts/sync-huangdi-neijing.ts",
        "knowledge-books:bootstrap-classics": "tsx scripts/bootstrap-classic-book-overviews.ts",
        "knowledge-books:scaffold": "tsx scripts/scaffold-knowledge-book.ts",
        "knowledge-books:import": "tsx scripts/import-knowledge-book-notes.ts",
        "power-analysis:setup": "node scripts/setup-power-analysis-venv.mjs",
        "power-analysis:worker": "node scripts/power-analysis-worker.mjs --queue",
        "power-analysis:poll-worker": "node scripts/power-analysis-worker.mjs --poll",
        "power-analysis:work-once": "node scripts/power-analysis-worker.mjs",
        "power-analysis:cleanup": "node scripts/power-analysis-worker.mjs --cleanup",
        "motion-effects:worker": "node scripts/motion-effects-worker.mjs --queue",
        "motion-effects:work-once": "node scripts/motion-effects-worker.mjs",
        "motion-effects:cleanup": "node scripts/motion-effects-worker.mjs --cleanup",
        "push-docker-ccr": "node scripts/push-docker-ccr.mjs",
        "push-power-worker-ccr": "node scripts/push-power-worker-ccr.mjs",
        "push-motion-effects-worker-ccr": "node scripts/push-motion-effects-worker-ccr.mjs",
        "dev:mobile": "node scripts/start-mobile-dev.cjs",
        "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
        "mobile:android": "npm --workspace apps/mobile run android",
        "mobile:ios": "npm --workspace apps/mobile run ios",
        "build:mobile:ios:preview": "npm --workspace apps/mobile run build:ios:preview",
        "build:mobile:ios:production": "npm --workspace apps/mobile run build:ios:production",
        "weapp:release:upload": "npm --workspace apps/wechat run release:upload",
        "weapp:release:audit": "npm --workspace apps/wechat run release:audit",
        "weapp:release:status": "npm --workspace apps/wechat run release:status",
        "weapp:release:wait-audit": "npm --workspace apps/wechat run release:wait-audit",
        "weapp:release:publish": "npm --workspace apps/wechat run release:publish",
        "weapp:release:auto": "npm --workspace apps/wechat run release:auto",
        "weapp:release:full": "npm --workspace apps/wechat run release:full",
        "weapp:release:categories": "npm --workspace apps/wechat run release:categories",
        "weapp:release:pages": "npm --workspace apps/wechat run release:pages",
        "wechat:xpay:catalog": "node scripts/sync-wechat-xpay-goods.mjs"
    },
    "dependencies": {
        "@coachlink/core": "0.0.0",
        "@dagrejs/dagre": "^1.1.8",
