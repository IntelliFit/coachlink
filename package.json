        "mammoth": "^1.11.0",
        "markdown-it": "^14.1.0",
        "next": "^16.0.1",
        "next-auth": "^4.24.13",
        "nodemailer": "^7.0.12",
        "openai": "^6.15.0",
        "p-limit": "^7.2.0",
        "pako": "^2.1.0",
        "pdf-parse": "^1.1.1",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.7",
        "qrcode-generator": "^2.0.4",
        "qrcode.react": "^4.2.0",
        "react": "^18.3.1",
        "react-beautiful-dnd": "^13.1.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^15.1.1",
        "react-parallax-tilt": "^1.7.315",
        "react-transition-group": "^4.4.5",
        "reactflow": "^11.11.4",
