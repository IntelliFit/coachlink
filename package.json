        "decimal.js": "^10.6.0",
        "dompurify": "^3.3.1",
        "dotenv": "^16.4.5",
        "driver.js": "^1.4.0",
        "framer-motion": "^12.23.24",
        "gradient-string": "^3.0.0",
        "html2canvas": "^1.4.1",
        "i18next": "^23.16.4",
        "isolated-vm": "^6.1.2",
        "jsonwebtoken": "^9.0.2",
        "kafkajs": "^2.2.4",
        "lenis": "^1.3.15",
